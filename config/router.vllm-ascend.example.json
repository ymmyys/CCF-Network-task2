{
  "listen": ":8080",
  "admin_listen": ":8081",
  "default_pool": "default",
  "pool_header": "X-Resource-Pool",
  "update_interval": "1s",
  "probe_timeout": "2s",
  "smooth_step": 0.25,
  "slow_start_duration": "15s",
  "passive_failure_threshold": 3,
  "passive_eject_duration": "10s",
  "scheduler": {
    "mode": "p2c_smooth_wrr"
  },
  "load": {
    "ewma_alpha": 0.35,
    "utilization_weight": 0.45,
    "queue_weight": 0.2,
    "inflight_weight": 0.15,
    "kv_cache_weight": 0.1,
    "latency_weight": 0.1,
    "queue_soft_limit": 32,
    "kv_cache_soft_limit": 1,
    "latency_slo_ms": 2000,
    "min_healthy_fraction": 0.03
  },
  "pools": [
    {
      "name": "default",
      "backends": [
        {
          "id": "vllm-ascend-0",
          "url": "http://127.0.0.1:9011",
          "capacity": 1,
          "max_inflight": 64,
          "health_url": "http://127.0.0.1:9011/health",
          "metrics_url": "http://127.0.0.1:9011/metrics"
        },
        {
          "id": "vllm-ascend-1",
          "url": "http://127.0.0.1:9012",
          "capacity": 1,
          "max_inflight": 64,
          "health_url": "http://127.0.0.1:9012/health",
          "metrics_url": "http://127.0.0.1:9012/metrics"
        }
      ]
    }
  ]
}
