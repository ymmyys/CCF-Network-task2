{
  "listen": ":8180",
  "admin_listen": ":8181",
  "default_pool": "default",
  "pool_header": "X-Resource-Pool",
  "update_interval": "1s",
  "probe_timeout": "2s",
  "smooth_step": 0.25,
  "slow_start_duration": "15s",
  "passive_failure_threshold": 3,
  "passive_eject_duration": "10s",
  "failure_cooloff_duration": "1s",
