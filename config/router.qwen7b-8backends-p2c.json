    "kv_cache_weight": 0.1,
    "latency_weight": 0.1,
    "queue_soft_limit": 8,
    "kv_cache_soft_limit": 1,
    "latency_slo_ms": 5000,
    "min_healthy_fraction": 0.03
  },
