    "hbm_weight": 0.15,
    "latency_weight": 0.10,
    "queue_soft_limit": 16,
    "kv_cache_soft_limit": 1,
    "hbm_soft_limit": 1,
    "latency_slo_ms": 2500,
    "min_healthy_fraction": 0.03
  },
